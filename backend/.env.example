# 카카오 로컬(장소 검색) REST API 키. 값은 팀 채널에서 받는다.
KAKAO_REST_API_KEY=

# 개발용 PostgreSQL(루트 docker-compose.yml) 접속 주소. 비밀번호는 루트 .env 의 POSTGRES_PASSWORD 와 같게 쓴다.
# 형식: postgresql+psycopg://barrierfree:<비밀번호>@localhost:5432/barrierfree
DATABASE_URL=

# 유동인구·날씨 수집 DB(Supabase) 접속 주소. 앱 DB와 따로 둔다.
# Supabase 프로젝트 Connect 의 Session pooler 주소(IPv4)를 넣고, [YOUR-PASSWORD] 는 DB 비밀번호로 바꾼다.
# 수집기(uv run python -m app.collector)만 쓴다. GitHub Actions 는 저장소 Secrets 의 같은 이름 값을 쓴다.
COLLECTOR_DATABASE_URL=

# S-DoT(유동인구) API 키. 값은 팀 채널에서 받는다.
SDOT_API_KEY=

# 기상청 API허브 인증키(현재 날씨). 값은 apihub.kma.go.kr 에서 발급한다. 사용할 API마다 활용신청이 필요하다.
KMA_API_KEY=

# 카카오·구글 로그인. 값은 팀 채널에서 받는다.
# 카카오 client_id 는 위 KAKAO_REST_API_KEY 를 같이 쓴다.
# 배포할 때는 OAUTH_REDIRECT_BASE_URL, FRONTEND_URL, AUTH_COOKIE_SECURE=true 를 배포 주소에 맞게 추가한다.
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 계정. provider:provider_user_id 를 쉼표로 잇는다. 예: google:1234567890,kakao:98765
ADMIN_ACCOUNTS=

# 제보 사진을 올리는 Supabase Storage. 비워 두면 data/report_photos/ 폴더에 저장한다(로컬 개발).
# 콘솔에서 비공개 버킷 report-photos 를 만들고(다른 이름이면 SUPABASE_PHOTO_BUCKET 을 추가), 서비스 키는 서버(backend/.env)에만 둔다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
