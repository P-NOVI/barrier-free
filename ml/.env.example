# Supabase Storage(S3 호환) 접속 정보(foot_traffic.storage). 대시보드 Storage > S3 Connection 에서 받는다.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
